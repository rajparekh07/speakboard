# The pinned design token export: the single source of key geometry (KEY-21).
#
# speakboard-tokens.json in this folder is a copy of the export published in
# Claude Design. scripts/metrics.sh refuses it unless its SHA-256 equals
# `sha256` below, and generates Sources/SpeakboardCore/Layout/GeneratedMetrics.swift
# from it. `make check` fails if either does not hold.
#
# The design system URL, publish label and token set version are for people:
# the artifact's version id is not reliable (export-format.md, "Pinning").
#
# The schema, validator and format note are the ones published beside that
# export, kept so the export can be validated when it is repinned. To repin,
# see CONTRIBUTING.md, "Design tokens".

design-system: https://claude.ai/artifact/X7uXynbGsf54dHirJhbb9x
publish-label: KEY-4 tokens v0.2.2
token-set-version: 0.2.2
